<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SqlSchemaDiff.Core</AssemblyName>
    <!-- The namespaces stay SqlSchemaDiff.* on purpose: renaming them would churn
         every consumer for no functional gain, and this is SQLDiff's engine. -->
    <RootNamespace>SqlSchemaDiff</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.8.1</Version>

    <!-- The public API is additive-only until 2.0, and "additive" is a promise about
         compiled assemblies, not about source. 1.8.0 broke it without a single test
         noticing: it turned BuildTableCreateOnly(TableModel) into an overload with an
         optional parameter, which recompiles cleanly and is a different method in IL,
         so PeopleWorks.SyncJob.Core 1.0.0 - built against 1.7 - threw
         MissingMethodException in production code the first time it made a staging
         table. Package validation compares this build against the baseline package on
         nuget.org at `dotnet pack` and fails on anything removed or changed.

         The baseline is 1.7.0 for this release on purpose: 1.8.0 was never validated,
         so checking against it would bless the break. After each release, move it to
         the version just published; every release is then a superset of the one
         before, and so of all of them. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.7.0</PackageValidationBaselineVersion>
    <!-- The package carries the family name since 1.6.0; the assembly and the
         namespaces do not, so a consumer only changes its PackageReference. The
         1.5.0 ids SqlSchemaDiff.Core / SqlSchemaDiff.Cli are deprecated on nuget.org
         and point here. -->
    <PackageId>PeopleWorks.SqlSchemaDiff.Core</PackageId>
    <Title>PeopleWorks SQLDiff Core</Title>
    <Authors>Pedro Hernandez (PeopleWorks)</Authors>
    <Company>PeopleWorks</Company>
    <Description>SQL Server schema extraction, comparison and data-preserving ALTER script generation. The engine behind SQLDiff, packaged so that CLIs, MCP servers and applications share one implementation instead of forking it.</Description>
    <PackageTags>sql-server;schema;diff;migration;ddl;alter-table;library</PackageTags>
    <PackageProjectUrl>https://github.com/peopleworks/SqlSchemaDiff</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peopleworks/SqlSchemaDiff</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source Link: the debugger fetches the exact sources from GitHub, so anyone
         consuming the package can step into it. PublishRepositoryUrl is what turns
         it on; EmbedUntrackedSources covers generated files that are not in git. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Symbols, as a .snupkg pushed alongside the .nupkg to the NuGet symbol
         server. The release workflow fails if one is missing. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlSchemaDiff.Tests" />
  </ItemGroup>

</Project>
